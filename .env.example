# SMTP credentials for the contact / order forms (nodemailer -> Gmail)
# Set these in Vercel: Project Settings -> Environment Variables
# For Gmail, SMTP_PASS must be an App Password (not your normal password).
SMTP_USER=espaceauto92.info@gmail.com
SMTP_PASS=your-gmail-app-password

# AutoPrécision APIs. Server side only: put the real values in .env.local
# (never committed) and in Vercel -> Environment Variables.
# 1. Vehicle identification (plate / VIN -> TecDoc KTYP). One credit per lookup.
AUTOPRECISION_VEHICLE_API_URL=https://siv-fr.autoprecision.fr
AUTOPRECISION_VEHICLE_TOKEN=
# 2. TecDoc catalogue (vehicles, part families, articles)
AUTOPRECISION_CATALOG_API_URL=https://api2.autoprecision.fr
AUTOPRECISION_CATALOG_KEY=
# 3. EasyOrder (supplier availability, prices, orders). PRODUCTION service: an order is real.
AUTOPRECISION_EASYORDER_API_URL=https://easyorder.autoprecision.fr
AUTOPRECISION_EASYORDER_TOKEN=
# Supplier gateway used by the shop: demo | autoprecision | teccom
SUPPLIER_GATEWAY=demo
# Real supplier orders stay off unless this is exactly "true"
AUTOPRECISION_ORDERS_ENABLED=false

# Stripe: online payment. Server side only, never NEXT_PUBLIC_.
# Secret key: Stripe dashboard -> Developers -> API keys. Start with the test
# key (sk_test_...): nothing is charged. sk_live_... takes real payments.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint https://<site>/api/stripe/webhook
# (Developers -> Webhooks -> Add endpoint. Events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed)
STRIPE_WEBHOOK_SECRET=

# Retail mark-up on the supplier purchase price, e.g. 0.6 for cost x 1.6 (capped
# at the manufacturer's public price). Empty = the value in src/lib/shop/config.ts;
# if that is not set either, the manufacturer's public price is shown.
CATALOG_MARKUP_ON_PURCHASE=
